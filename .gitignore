# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
.env

# IDE
.idea/
.vscode/
*.swp
*.swo
.qodana/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Data cache / temp
tmp.py/
tmp/
# .comate/ 下只让 rules/ 入库（IDE 读取的项目规则，需要跟着仓库走），
# specs/ 等本地状态不入库。必须写 .comate/* 而不是 .comate/ ——
# 带斜线是整目录排除，git 根本不往里扫，后面的 !.comate/rules/ 就失效了。
#.comate/*
#!.comate/rules/

# Large binaries / generated
*.pptx
*.xlsx
*.pdf

# Chart / images output (可选，按需保留)
*.png

# Secrets / drafts (含真实登录 token，勿入库)
draft.json

# 个人 prompt / 思考草稿，不入库（principle.txt 例外）
prompt/*.txt

# 原始抓取数据，可由 extract/ 脚本重新拉取
data/raw/

# 本地起 Flask 服务时 nohup 出来的运行日志，不入库
visit.log

milestone.md