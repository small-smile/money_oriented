{
  "_meta": {
    "company": "中国移动有限公司 China Mobile Limited",
    "coverage": "2001–2025 财年（期末数与全年数）",
    "extractedAt": "2026-09-01",
    "sourcePrimary": "公司历年年报「主要营运数据」表 + 官网投资者关系「营运数据／客户数据」页",
    "sourcePriority": "2022–2025 年以 A 股年报为准，2001–2021 年用港股年报；官网营运数据页用于交叉核对。注：官网 operation_y.php?year= 与 financial.php?year= 参数均无效，始终返回最新年度。",
    "units": {
      "mobileSubs": "亿户（期末）",
      "netAddSubs": "万户（全年净增，可为负）",
      "subs3G / subs4G / subs5G / subs5GPackage": "亿户（期末）",
      "mou": "分钟/户/月",
      "dou": "GB/户/月（2013–2017 年报原文为 MB，已按 1GB=1024MB 折算）",
      "arpu / homeArpu / broadbandArpu": "人民币元/户/月",
      "broadbandSubs / homeBroadbandSubs / gigabitSubs": "亿户（期末）",
      "govEntSubs": "百万（政企客户数）",
      "iotConnections": "亿（物联网卡连接数）",
      "base5G": "万站（5G 基站，累计开通）",
      "baseStations": "个（移动基站总数，早年口径）",
      "idcRacks": "万架（对外服务 IDC 标准机架，按单机架 2.5KW 折合）",
      "employees": "人",
      "totalMinutes": "亿分钟（全年总通话分钟数）",
      "smsVolume": "亿条（全年短信使用量）",
      "totalDataTraffic": "PB（全年无线上网/移动数据流量）",
      "vasShare": "%（增值业务／数据业务收入占营运收入）"
    },
    "rules": {
      "missingData": "该年年报未披露的字段一律记 null，不估算、不插值，也不用 DOU×客户数×12 之类的方式反推。",
      "unitNormalization": "客户数原文多为「千户／百万户」，统一折算为亿户；净增原文为「百万户」，统一折算为万户；DOU 的 MB→GB 按 1024 折算；流量总量的「十亿MB」按 1PB=1,048,576MB 折算为 PB。",
      "approximate": "年报用「约 45 万人」这类约数披露员工人数的年份，数值记为该约数并置 employeesApprox=true。"
    },
    "definitions": {
      "douBasis": "「平均每月每户手机上网流量」，2013–2017 年报以 MB 计、2018 年起以 GB 计；本表统一为 GB。同期年报另披露「4G 客户 DOU」，口径更窄，未并入本表。",
      "gen5GBasis": "「5G 网络客户数」与「5G 套餐客户数」是两个不同口径：套餐客户 2019–2023 年披露，网络客户 2021 年起披露、2024 年起进入主表。2021–2023 两者同时可得，差额分别为 1.8／2.8／3.3 亿户；混用会把 2023 的 7.95 亿（套餐）与 2024 的 5.52 亿（网络）读成负增长。",
      "broadbandBasis": "2024 年及以前为「有线宽带客户数」；2025 年改口径为「宽带联网客户」，按官网脚注定义包含家庭宽带、企业宽带、互联网专线和数据专线，2024 的 3.15 亿与 2025 的 3.29 亿不是同口径。",
      "subsBasis": "2001 年为当年上市主体十三家移动通信公司综合口径，2002–2004 年按二十一家／三十一家子公司备考合并口径重述，因此 2001–2004 的客户数在不同年报中数值不同；本表取各年年报的原披露数。",
      "trafficBasis": "2012–2013 的流量口径为「无线上网业务流量」（含 WLAN），2014–2015 改为「移动数据流量」（蜂窝口径），两段不可直接首尾相接。"
    },
    "gaps": {
      "总量指标（通话分钟／短信条数／流量）": "最后一次披露为 2015 年年报；2016 年起「主要营运数据」表只剩 MOU/DOU/ARPU 三行，2016–2025 连续十年无总量披露。2020、2021 年报只给「总通话分钟数较上年下降 6.0%／1.2%」的同比增速，无绝对值，未据此反推。",
      "彩信使用量": "2012 年起任何一份年报都不再作为总量行披露，只有「短彩信业务收入」。",
      "subs4G": "2022 年起「主要营运数据」表取消 4G 客户数一行，2022–2025 为 null。",
      "总连接数": "2017 年报只有「突破 14 亿」这类门槛式表述、2023 年报只有脚注定义，均无精确值，故不入表。",
      "员工与基站": "多数年份不在「主要营运数据」表内，取自公司简介或董事长报告书正文；2016、2018 等年份未披露员工数。"
    }
  },
