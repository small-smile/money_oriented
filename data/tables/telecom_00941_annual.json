    "rules": {
      "missingData": "该年年报未披露的字段一律记 null，不估算、不插值、不由相邻年份或其他指标反算。",
      "restatement": "同一年份在不同年报中被重列时，本表取<b>该年年报的原披露数</b>，重列数写进当年的 _restated 说明，不覆盖原数。",
      "unitNormalization": "正文多用「亿元」，报表用「百万元」，本表统一折算为百万元（亿元×100）。"
    },
    "definitions": {
      "mixBase": "当年「收入拆分」的分母。2013 年起公司把终端销售单列，分母用主营业务收入（通信服务收入）；2013 年之前的「营运收入」本身就是通信服务口径（终端销售未单独列示），分母即营运收入。2002 与 2004 年公司只按备考合并口径披露收入拆分，分母用备考合并数（与经审计的 totalRevenue 不同，已在 _restated 里注明）。",
      "mixLayers": "当年构成「完全划分」的字段名列表。运营商的收入口径二十多年换过三轮，同一年里「增值业务」与它的子项（短信、无线上网）不能同时入栈，因此逐年显式给出哪几层相加等于 mixBase，剩余部分由页面现算为「未单列」。",
      "voiceRevenue": "2001–2002 年为「通话费」（月租费、入网费单列）；2003–2010 年年报把两者合并为「通话费及月租费」一行，无法再拆，故 monthlyFee 自 2003 年起为 null；2011 年起该行改称「语音业务」。",
      "vasRevenue": "2001–2010 年的「新业务收入／增值业务收入」总口径。2011 年起公司把它改称「数据业务」（dataBusinessRevenue），并在其下拆出短信及彩信、无线上网、应用及信息服务。",
      "dataRevenue": "无线上网（手机流量）业务收入。2010 年首次以「数据流量业务收入」名义披露，2011 年起改称「无线上网业务收入」。",
      "serviceRevenueBasis2025": "2025 年年报把主营业务改按「通信服务／算力服务／智能服务」三项列示，与此前「无线上网／有线宽带／应用及信息服务」不是同一刀切法，跨 2025 年比较产品线时必须留意。"
    },
    "gaps": {
      "capex": "2001 年未披露；2002–2004 年公司只用美元披露资本开支（约 60 / 60 / 78 亿美元），年报未给人民币金额，故人民币字段为 null；2005 年起改用人民币披露。2009–2014 年部分年份年报正文未单列资本开支金额。",
      "payoutRatio": "公司自 2017 年年报起偶有披露、2021 年起逐年披露全年派息率；此前年份为 null，不由股息／每股盈利反算（股息以港元计、盈利以人民币计，反算无意义）。",
      "opexBreakdown": "营运支出六分项（网络运营及支撑、折旧摊销、雇员薪酬、销售费用、销售产品成本、其他）自 2017 年起口径稳定；2016 年及以前年报用的是「电路及网元租赁费／网间互联支出／折旧／…」另一套分项，未并入本表。"
    }
